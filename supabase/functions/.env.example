# Variables para `supabase functions serve --env-file supabase/functions/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY las inyecta el CLI en local.

# Secreto compartido con el que la pasarela mock firma los webhooks (HMAC-SHA256).
MOCK_WEBHOOK_SECRET=mock-secret-local

# Opcional: URL pública base de las funciones si no se puede deducir del header Host
# (ej. cuando probás desde el teléfono: http://192.168.1.10:54321/functions/v1).
# FUNCTIONS_PUBLIC_URL=
