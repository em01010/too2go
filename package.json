{
  "name": "too2go",
  "private": true,
  "version": "0.1.0",
  "description": "Too2Go: bolsas sorpresa de comida con descuento en Tegucigalpa",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @too2go/mobile start",
    "dev:web": "pnpm --filter @too2go/web dev",
    "build:web": "pnpm --filter @too2go/web build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/types/database.ts && prettier --write packages/shared/src/types/database.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "functions:check": "cd supabase/functions && deno check create-payment/index.ts payment-webhook/index.ts mock-checkout/index.ts delete-account/index.ts && deno lint && deno fmt --check",
    "functions:fmt": "cd supabase/functions && deno fmt",
    "smoke:payments": "./scripts/smoke-payments.sh",
    "dev:phone": "./scripts/dev-phone.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "deno": "^2.9.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
