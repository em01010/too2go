# Copiá este archivo a .env y completá los valores. Expo solo expone variables con prefijo EXPO_PUBLIC_.
# Con Supabase local: la URL debe ser la IP de tu computadora en la red Wi‑Fi (no localhost) para que el teléfono llegue.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_SUPPORT_WHATSAPP=+50400000000
